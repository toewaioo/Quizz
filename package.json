    "clsx": "^2.1.1",
    "concurrently": "^9.0.1",
    "framer-motion": "^12.23.26",
    "globals": "^15.14.0",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "laravel-vite-plugin": "^2.0",
